{
  "version": "MAR_ER_V1_ONE_SHOT",
  "evaluation_split": "dev",
  "design_spec": "reports/MAR_ER_DESIGN/METHOD_SPEC.md",
  "methods": {
    "M0": {"adaptive_fusion": false, "candidate_recovery": false, "rank_stability": false},
    "M1": {"adaptive_fusion": true, "candidate_recovery": false, "rank_stability": false},
    "M2": {"adaptive_fusion": false, "candidate_recovery": true, "rank_stability": false},
    "M3": {"adaptive_fusion": false, "candidate_recovery": false, "rank_stability": true},
    "M4": {"adaptive_fusion": true, "candidate_recovery": true, "rank_stability": true}
  },
  "model": {
    "id": "intfloat/multilingual-e5-large",
    "revision": "3d7cfbdacd47fdda877c5cd8a79fbcc4f2a574f3",
    "query_prefix": "query: ",
    "passage_prefix": "passage: ",
    "max_length": 512,
    "batch_size": 16,
    "normalize_embeddings": true
  },
  "windowing": {
    "content_tokens": 384,
    "overlap_tokens": 128,
    "aggregation": "max",
    "raw_cache": "outputs/R1/cache/r0_window_embeddings.npy",
    "text_context_cache": "outputs/R1/cache/r1_window_embeddings.npy",
    "table_struct_cache": "outputs/MASH_ER/cache/table_struct_window_embeddings.npy"
  },
  "retrieval": {
    "matched_baseline": "MASH_ER_A0_RAW_HARD_PAGE20",
    "page_representation": "P0_FIXED",
    "hard_page_budget": 20,
    "page_rank_limit": 100,
    "page_region_source": "outputs/B2_1/rankings/p0_p20_dev_top200.jsonl",
    "candidate_budget": 100,
    "candidate_anchor": 80,
    "rescue_quota": 20,
    "source_depth": 100,
    "final_k": 20,
    "intrusion_budget": 5,
    "protected_top_k": 15,
    "rrf_k": 60,
    "rank_utility": "(rrf_k + 1) / (rrf_k + rank); missing=0",
    "raw_relevance": "0.5 * u_bm25 + 0.5 * u_raw",
    "corroboration": "max(u_bm25, u_page)",
    "adaptive_dense": "u_raw + alternate_valid * corroboration * max(u_alternate - u_raw, 0)",
    "adaptive_relevance": "0.5 * u_bm25 + 0.5 * adaptive_dense",
    "candidate_sources": [
      "MATCHED_BASELINE_A0",
      "GLOBAL_BM25_RAW",
      "GLOBAL_E5_RAW",
      "UNIFIED_MODALITY_ALTERNATE_E5",
      "P0_PAGE_TO_REGION"
    ],
    "tie_break": ["score_desc", "baseline_rank_asc", "evidence_id_asc"]
  },
  "statistics": {
    "bootstrap_resamples": 1000,
    "seed": 42,
    "confidence_level": 0.95,
    "cluster_key": "canonical_sorted_gold_evidence_ids"
  },
  "expected_counts": {
    "retrieval_units": 27045,
    "text_units": 26954,
    "table_units": 91,
    "dev_qa": 93,
    "retrieval_multi_qa": 25,
    "unique_gold_sets": 45,
    "multi_unique_gold_sets": 8
  },
  "candidate_test_policy": "SEALED_NOT_PARSED; BYTE_HASH_ONLY",
  "one_shot": true,
  "post_result_parameter_changes_allowed": false,
  "paper_ready_default": false
}
