{
  "baseline_tolerance": {
    "multi_qa_count": 1,
    "overall_qa_count": 1
  },
  "candidate_test_policy": "SEALED_NOT_PARSED; BYTE_HASH_ONLY",
  "evaluation_split": "dev",
  "model": {
    "batch_size": 16,
    "id": "intfloat/multilingual-e5-large",
    "max_length": 512,
    "normalize_embeddings": true,
    "passage_prefix": "passage: ",
    "query_prefix": "query: "
  },
  "representations": [
    "R0",
    "R1",
    "R2"
  ],
  "retrieval": {
    "bm25": "FIXED_B2_CACHE",
    "candidate_budget": 100,
    "final_k": 20,
    "page_budget": 20,
    "page_representation": "P0_FIXED",
    "rrf_k": 60
  },
  "statistics": {
    "bootstrap_resamples": 1000,
    "seed": 42
  },
  "version": "R1",
  "windowing": {
    "aggregation": "max",
    "apply_to_all_representations": true,
    "content_tokens": 384,
    "overlap_tokens": 128
  }
}
