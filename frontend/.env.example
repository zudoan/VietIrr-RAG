# Browser API base. Leave empty in local development to use the Vite /api proxy.
VITE_API_BASE=

# Optional safe deployment repository URL. Leave empty until the clean repository is approved.
VITE_SOURCE_REPOSITORY_URL=

# Vite development proxy target (read by vite.config.ts).
VIETIRR_API_PROXY=http://127.0.0.1:8000
